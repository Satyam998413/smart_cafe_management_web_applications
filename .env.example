PORT=3000
# TCP port the embedded MQTT broker (server.js, via src/lib/mqttServer.js)
# listens on for 'mqtt'-transport devices. Defaults to the standard 1883 —
# override this if something else on the host already owns that port (e.g.
# a separately-installed Mosquitto service running locally for unrelated
# reasons; check `netstat -ano | findstr 1883` on Windows before assuming
# it's free).
MQTT_PORT=1883
# This app's own public origin (plan Phase 10B) — used to build absolute
# URLs in sitemap.xml/robots.txt and the guest ordering page's canonical
# link/JSON-LD. Falls back to http://localhost:$PORT when unset, so this is
# only required once the app has a real deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# From Project Settings > API in the Supabase dashboard — same project the
# Express server (server/.env) uses, unless you're deliberately starting the
# Next.js app on a fresh Supabase project.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# This app's own auth-token secret — copy the same value from server/.env
# so existing tokens keep working during a side-by-side migration, or set a
# fresh one if the two apps are never meant to share sessions.
JWT_SECRET=your_jwt_secret_here
# The Supabase PROJECT's own JWT signing secret (Project Settings > API >
# JWT Secret) — NOT the same value as JWT_SECRET above. Used to mint the
# tenant-scoped RLS JWT (Phase 0c) and to verify Google-login tokens
# (Phase 9).
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret-here
# Signs the long-lived (non-expiring) access tokens issued to paired IoT
# hardware — see src/lib/deviceAuth.js. Deliberately its own secret, never
# JWT_SECRET: a device-token leak is contained by rotating this alone,
# without logging out every human session. Generate one the same way as
# JWT_SECRET (any long random string).
DEVICE_JWT_SECRET=your_device_jwt_secret_here
# Project Settings > API > Project API keys > service_role (secret) — bypasses
# RLS entirely. Only ever read by CLI scripts (seed/*.js), never imported by
# any Route Handler or shipped to a client. Required for `npm run seed`,
# `npm run seed:clean`, and `npm run db:clean` to write once RLS is enforced.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# AI waiter/chat brain (Smart Waiter + Cafe AI) — powers POST /api/ai/chat.
# Both Flutter and React call this endpoint; the provider/key live only
# here, never on a client device. Every provider below that has an API key
# set is tried in this priority order (comma-separated). If one errors or
# times out, the server falls through to the next and demotes the failed
# one to the back of the queue for every future request.
AI_PROVIDER_PRIORITY=local,openrouter
LOCAL_AI_BASE_URL=http://187.127.189.252:20128/v1
LOCAL_AI_API_KEY=your_key_here
LOCAL_AI_MODEL=auto/chat
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Firebase service account JSON (Project Settings > Service Accounts >
# Generate new private key), base64-encoded onto a single line:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('./service-account.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json_here
# Encrypts every user-provided secret this platform stores at rest — per-
# tenant AI keys (Phase 7) today, BYO-Supabase credentials (Phase 8) later.
# Must decode from base64 to exactly 32 bytes; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every already-encrypted row undecryptable — treat
# it like a database password, not a value to regenerate casually.
CREDENTIAL_ENCRYPTION_KEY=your_base64_32_byte_key_here
# Client-side Firebase Web config (Project Settings > General > Your apps >
# Web app) — public client identifiers, not secrets, safe to ship in the
# bundle. Must also be kept in sync with public/firebase-messaging-sw.js,
# which can't read env vars. Powers push-notification registration
# (requestFcmToken in lib/firebaseClient.js) — everything else in the app
# works without these being set.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
# Firebase Console > Project Settings > Cloud Messaging > Web Push
# certificates — required for requestFcmToken() to actually mint a token;
# without it, push registration silently no-ops (everything else still works).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here
